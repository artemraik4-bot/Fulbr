<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgBrush" Color="#0B1220" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#0B1220" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#111A2B" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#16223A" />
    <SolidColorBrush x:Key="Surface3Brush" Color="#1C2A44" />
    <SolidColorBrush x:Key="BorderBrush" Color="#22304A" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6EDF7" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8FA3BF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#5EEAD4" />
    <SolidColorBrush x:Key="Accent2Brush" Color="#38BDF8" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="#1A5EEAD4" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FB7185" />
    <SolidColorBrush x:Key="DangerTintBrush" Color="#1AFB7185" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
    <SolidColorBrush x:Key="SuccessTintBrush" Color="#1A34D399" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="WarnTintBrush" Color="#1AFBBF24" />
    <SolidColorBrush x:Key="NavActiveBrush" Color="#1C3A4A" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#15243A" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#1E3A4A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1E3A4A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E6EDF7" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1E3A4A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E6EDF7" />
</ResourceDictionary>

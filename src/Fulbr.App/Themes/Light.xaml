<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgBrush" Color="#F5F7FB" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#F5F7FB" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#EEF3F9" />
    <SolidColorBrush x:Key="Surface3Brush" Color="#E2EAF4" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D8E1EC" />
    <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="MutedBrush" Color="#5B6B82" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0EA5A4" />
    <SolidColorBrush x:Key="Accent2Brush" Color="#0284C7" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="#1A0EA5A4" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E11D48" />
    <SolidColorBrush x:Key="DangerTintBrush" Color="#1AE11D48" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#059669" />
    <SolidColorBrush x:Key="SuccessTintBrush" Color="#1A059669" />
    <SolidColorBrush x:Key="WarnBrush" Color="#B45309" />
    <SolidColorBrush x:Key="WarnTintBrush" Color="#1AF59E0B" />
    <SolidColorBrush x:Key="NavActiveBrush" Color="#DDF3F1" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#EAF0F7" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#DDF3F1" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#DDF3F1" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#DDF3F1" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A" />
</ResourceDictionary>
